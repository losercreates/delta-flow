# ==============================================================================
# DeltaFlow Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env to override defaults for Docker Compose and local runs.
#   cp .env.example .env

# --- Database & Storage Configuration ---
POSTGRES_DB=deltaflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Redis Distributed Cache & Lock Lease Configuration ---
REDIS_PORT=6379

# --- Message Broker (Redpanda / Kafka) ---
KAFKA_PORT=9092

# --- DeltaFlow Backend Service ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=--enable-preview -Xms512m -Xmx1024m

# --- DeltaFlow Operator Dashboard Frontend ---
FRONTEND_PORT=3000

# --- OpenTelemetry & Jaeger Distributed Tracing ---
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# --- Prometheus Metrics Scraper ---
PROMETHEUS_PORT=9090

# --- Grafana Visualization Dashboard ---
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
